# Copy to .env (git-ignored). Read only by the Vite dev/preview proxy, never bundled.
SERVER_URL=http://localhost:4000
# Same value as services/server's WORKER_SHARED_SECRET; lets the proxy read scheduled jobs.
WORKER_SHARED_SECRET=change-me
# DAS-capable RPC for identity reads and sending wallet-signed transactions.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public, bundled into the app:
VITE_NETWORK=devnet
