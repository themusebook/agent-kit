{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@themusebook/agent-kit": ["../../packages/client/src/index.ts"],
      "@themusebook/agent-kit-identity": ["../../packages/identity/src/index.ts"],
      "@themusebook/agent-kit-discovery": ["../../packages/discovery/src/index.ts"],
      "@themusebook/agent-kit-payments": ["../../packages/payments/src/index.ts"],
      "@themusebook/agent-kit-wallet": ["../../packages/wallet/src/index.ts"],
      "@themusebook/agent-kit-auth": ["../../packages/auth/src/index.ts"],
      "@solana/web3.js": ["./node_modules/@solana/web3.js"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "proxy.config.ts"]
}
