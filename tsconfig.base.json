{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@musebook/a2a-network": [
        "packages/a2a-network/src/index.d.mts"
      ],
      "@musebook/agent-kit": [
        "packages/client/src/index.ts"
      ],
      "@musebook/identity": [
        "packages/identity/src/index.ts"
      ],
      "@musebook/auth": [
        "packages/auth/src/index.ts"
      ],
      "@musebook/discovery": [
        "packages/discovery/src/index.ts"
      ],
      "@musebook/payments": [
        "packages/payments/src/index.ts"
      ],
      "@musebook/finance": [
        "packages/finance/src/index.ts"
      ],
      "@musebook/templates": [
        "packages/templates/src/index.ts"
      ],
      "@musebook/stonk": [
        "packages/stonk/src/index.ts"
      ],
      "@musebook/perps": [
        "packages/perps/src/index.ts"
      ],
      "@musebook/a2a": [
        "packages/a2a/src/index.ts"
      ],
      "@musebook/wallet": [
        "packages/wallet/src/index.ts"
      ],
      "@musebook/x402-metaplex": [
        "packages/x402-metaplex/src/index.ts"
      ]
    }
  }
}
