{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@themusebook/agent-kit-a2a-network": [
        "packages/a2a-network/src/index.d.mts"
      ],
      "@themusebook/agent-kit": [
        "packages/client/src/index.ts"
      ],
      "@themusebook/agent-kit-identity": [
        "packages/identity/src/index.ts"
      ],
      "@themusebook/agent-kit-auth": [
        "packages/auth/src/index.ts"
      ],
      "@themusebook/agent-kit-discovery": [
        "packages/discovery/src/index.ts"
      ],
      "@themusebook/agent-kit-payments": [
        "packages/payments/src/index.ts"
      ],
      "@themusebook/agent-kit-finance": [
        "packages/finance/src/index.ts"
      ],
      "@themusebook/agent-kit-templates": [
        "packages/templates/src/index.ts"
      ],
      "@themusebook/agent-kit-stonk": [
        "packages/stonk/src/index.ts"
      ],
      "@themusebook/agent-kit-perps": [
        "packages/perps/src/index.ts"
      ],
      "@themusebook/agent-kit-a2a": [
        "packages/a2a/src/index.ts"
      ],
      "@themusebook/agent-kit-wallet": [
        "packages/wallet/src/index.ts"
      ],
      "@themusebook/agent-kit-x402-metaplex": [
        "packages/x402-metaplex/src/index.ts"
      ]
    }
  }
}
