{
  "name": "@musebook/trading-agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/release/check-dist.mjs"
  },
  "dependencies": {
    "@ellipsis-labs/rise": "0.6.4",
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@raydium-io/raydium-sdk-v2": "0.2.79-alpha",
    "@solana/spl-token": "0.4",
    "@solana/web3.js": "1",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "typescript": "5"
  },
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themusebook/agent-kit.git",
    "directory": "agents/trading"
  },
  "homepage": "https://github.com/themusebook/agent-kit/tree/main/agents/trading#readme",
  "bugs": {
    "url": "https://github.com/themusebook/agent-kit/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decision": {
      "types": "./dist/decision/index.d.ts",
      "default": "./dist/decision/index.js"
    },
    "./perps": {
      "types": "./dist/perps/index.d.ts",
      "default": "./dist/perps/index.js"
    },
    "./pumpfun-founder": {
      "types": "./dist/pumpfun-founder/index.d.ts",
      "default": "./dist/pumpfun-founder/index.js"
    },
    "./stonk": {
      "types": "./dist/stonk/index.d.ts",
      "default": "./dist/stonk/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
