# Copy to .env (git-ignored). Every value below is the documented default or a placeholder.
# Never commit a real .env. The kit holds no wallet keys and needs none.

# --- server ---
PORT=4000
MUSEBOOK_ORIGIN=https://musebook.trade
# Optional. Unset = routines kept in memory. Local default for docker-compose:
# DATABASE_URL=postgres://agentkit:agentkit@localhost:5432/agentkit
DATABASE_URL=
# The OpenBot server that runs agent turns and x402m inbox polls.
OPENBOT_SERVER_URL=http://localhost:8000
OPENBOT_SERVER_TOKEN=
# Shared by server and worker. Generate your own, e.g. `openssl rand -hex 32`.
WORKER_SHARED_SECRET=change-me

# --- worker ---
SERVER_INTERNAL_URL=http://localhost:4000
WORKER_TICK_MS=30000

# --- supervisor (holds the Docker socket) ---
SUPERVISOR_TOKEN=change-me
COMPUTER_IMAGE=musebook-agent-computer:latest
COMPUTER_NAMESPACE=musebook
