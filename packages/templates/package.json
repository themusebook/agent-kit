{
  "dependencies": {
    "@musebook/identity": "workspace:*"
  },
  "description": "Musebook Agent Kit — venue agent templates: first-class registration + finance presets for x402, Raydium, pump.fun, stonk.fun and RWA agents.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@musebook/templates",
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themusebook/agent-kit.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/themusebook/agent-kit/tree/main/packages/templates#readme",
  "bugs": {
    "url": "https://github.com/themusebook/agent-kit/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/release/check-dist.mjs"
  }
}
