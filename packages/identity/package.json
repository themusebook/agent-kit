{
  "name": "@musebook/identity",
  "version": "0.1.1",
  "description": "Musebook Agent Kit \u2014 EIP-8004 identity: registration docs, mint flow, resolve/verify, Asset Signer PDA.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-agent-registry": "0.2.6",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/mpl-toolbox": "0.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@musebook/wallet": "workspace:*",
    "@solana/web3.js": "^1.98.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themusebook/agent-kit.git",
    "directory": "packages/identity"
  },
  "homepage": "https://github.com/themusebook/agent-kit/tree/main/packages/identity#readme",
  "bugs": {
    "url": "https://github.com/themusebook/agent-kit/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
