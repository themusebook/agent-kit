{
  "dependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "description": "Musebook Agent Kit — stonk.fun (Stonkfun) Developer API client: market reads, API-built launches, BYO Raydium LaunchLab launch plans with adoption validation, and Fee Key NFT fee claims. Non-custodial: no API key exists; the caller's wallet signature authorizes launches and claims.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@musebook/stonk",
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themusebook/agent-kit.git",
    "directory": "packages/stonk"
  },
  "homepage": "https://github.com/themusebook/agent-kit/tree/main/packages/stonk#readme",
  "bugs": {
    "url": "https://github.com/themusebook/agent-kit/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/release/check-dist.mjs"
  }
}
